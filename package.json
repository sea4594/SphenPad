    "write-phase11-release-hashes": "node scripts/write-phase11-release-hashes.mjs",
    "finish-phase11-release": "bash scripts/finish-phase11-release.sh",
    "test-phase11-playtest-regressions": "node scripts/test-phase11-playtest-regressions.mjs",
